        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56"
                TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>um which meant that no machinery actually commenced work until the second day which was, which was the Wednesday.</ANNOTATION_VALUE>
